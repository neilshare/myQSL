{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myqsl",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/readyz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myqsl-prod",
      "database_id": "4d33ddbf-9ed2-4b96-a435-a8e6dc175b96",
      "migrations_dir": "./infra/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "myqsl-media" }],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://myqsl.app",
    "ACCESS_TEAM_DOMAIN": "https://myqsl.cloudflareaccess.com",
    "ACCESS_AUD": "myqsl-production-audience"
  },
  "observability": { "enabled": true },
  "workflows": [
    {
      "name": "myqsl-d1-backup",
      "binding": "D1_BACKUP_WORKFLOW",
      "class_name": "D1BackupWorkflow",
      "schedules": ["0 20 * * *"]
    }
  ]
}
